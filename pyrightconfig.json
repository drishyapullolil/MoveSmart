{
  "include": [
    "backend/ai_monitoring"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/__pyrefly_virtual__",
    "**/__pyrefly_virtual__/**"
  ],
  "extraPaths": [
    "./backend/ai_monitoring",
    "./backend"
  ],
  "executionEnvironments": [
    {
      "root": "backend/ai_monitoring",
      "extraPaths": [
        "."
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        "backend/ai_monitoring",
        "backend"
      ]
    }
  ],
  "stubPath": "typings",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows"
}

